digraph Architecture {
  graph [bgcolor="white", rankdir=TB, nodesep=0.45, ranksep=0.65, fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", color="#DCE3F1", fillcolor="#F4F5FD", fontname="DejaVu Sans", fontsize=13, margin="0.2,0.12"];
  edge [color="#6C63C8", arrowsize=0.7, fontname="DejaVu Sans", fontsize=10];
  browser [label="NAVEGADOR / OPERA\nHTML + CSS + JavaScript\nExplorador • Live • Reportes", fillcolor="#E9E7FF"];
  http [label="SERVIDOR NODE.JS\nsrc/server.js\nRutas, sesiones, roles y CSRF", fillcolor="#F7F9FD"];
  live [label="src/live.js\nAvisos WebSocket",fillcolor="#EBF8FB"];
  reports [label="src/reports.js\nResúmenes + CSV",fillcolor="#EBF8FB"];
  db [label="src/db.js\nConsultas parametrizadas\ny transacciones",fillcolor="#F1EFFF"];
  sqlite [label="SQLite persistente\nusers • sessions • tickets\nticket_events • guest_ticket_access",fillcolor="#E8F5EE"];
  browser -> http [label="HTTPS* / HTTP local"];
  browser -> live [label="WebSocket /live"];
  http -> reports;
  http -> db;
  live -> db;
  db -> sqlite;
  note [shape=plaintext, label="* HTTPS con Caddy está previsto, no verificado públicamente.", fontsize=10, fontcolor="#666C82"];
  sqlite -> note [style=invis];
}

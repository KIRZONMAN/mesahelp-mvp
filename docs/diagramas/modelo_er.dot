digraph ER {
  graph [bgcolor="white", rankdir=LR, nodesep=0.45, ranksep=0.85, fontname="DejaVu Sans"];
  node [shape=record, style="rounded,filled", color="#C6CCEB", fillcolor="#F7F6FF", fontname="DejaVu Sans", fontsize=11, margin="0.16,0.12"];
  edge [color="#7067C9", penwidth=1.3, arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];
  users [label="{users|PK id\lusername UNIQUE\lpassword_hash\lrole\lcreated_at\l}"];
  sessions [label="{sessions|PK token_hash\lFK user_id\lcsrf_token\lexpires_at\l}"];
  tickets [label="{tickets|PK id\lFK requester_id\lsubject, description\lcategory, priority, status\lcreated_at, updated_at\l}"];
  events [label="{ticket_events|PK id\lFK ticket_id\lFK actor_id\lold_status, new_status\lnote, created_at\l}"];
  guest [label="{guest_ticket_access|PK/FK ticket_id\lcode_hash UNIQUE\lcreated_at\l}"];
  users -> sessions [label="1:N"];
  users -> tickets [label="1:N solicitante"];
  tickets -> events [label="1:N"];
  users -> events [label="1:N actor"];
  tickets -> guest [label="1:0..1"];
}
